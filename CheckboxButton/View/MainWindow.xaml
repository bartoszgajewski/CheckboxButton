<Window x:Class="CheckboxButton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CheckboxButton"
        xmlns:vm="clr-namespace:CheckboxButton.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="300" MinHeight="200">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Margin="20"
                Command="{Binding PokazKomunikatCommand}">
            Komunikat
        </Button>

        <CheckBox Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsChecked="{Binding CzyZaznaczono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            Tak/Nie
        </CheckBox>
    </Grid>
</Window>